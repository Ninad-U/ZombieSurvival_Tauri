{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZombieSurvival",
  "version": "0.1.0",
  "identifier": "com.zombiesurvival.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "ZombieSurvival",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
"bundle": {
  "active": true,
  "icon": [
    "icons/icon.ico"
  ],
  "windows": {
    "certificateThumbprint": null,
    "digestAlgorithm": "sha256",
    "timestampUrl": ""
  }
},
  "plugins": {
    "fs": {
      "allowlist": [
        {
          "path": "**"
        }
      ]
    }
  }
}
